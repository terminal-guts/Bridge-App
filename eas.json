{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "internal": {
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      },
      "channel": "internal"
    },
    "production": {
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      },
      "channel": "production"
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "appleId": "saulbrauns@gmail.com",
        "ascAppId": "6759764704",
        "appleTeamId": "D9C93RG4RZ"
      }
    },
    "production": {
      "ios": {
        "appleId": "saulbrauns@gmail.com",
        "ascAppId": "6759764704",
        "appleTeamId": "D9C93RG4RZ"
      }
    }
  }
}
