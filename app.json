{
  "expo": {
    "newArchEnabled": true,
    "name": "Bridge: Social Matchmaking",
    "slug": "bridge",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/BridgeIcon_Final.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#2563EB"
    },
    "assetBundlePatterns": [
      "assets/Icons/**",
      "assets/*.png",
      "assets/*.jpg",
      "assets/*.json"
    ],
    "ios": {
      "jsEngine": "hermes",
      "supportsTablet": false,
      "bundleIdentifier": "com.bridgedate.app",
      "buildNumber": "3",
      "appleTeamId": "D9C93RG4RZ",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSCameraUsageDescription": "Bridge needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "Bridge needs photo library access to upload profile photos.",
        "NSPhotoLibraryAddUsageDescription": "Bridge needs permission to save photos.",
        "NSMicrophoneUsageDescription": "Bridge needs microphone access for voice features.",
        "NSLocationWhenInUseUsageDescription": "Bridge uses your location to show nearby matches.",
        "NSContactsUsageDescription": "Bridge uses your contacts to help you invite friends via SMS.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/BridgeLogo-Photoroom.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bridge.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "scheme": "bridge",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-image-picker",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/BridgeLogo-Photoroom.png",
          "color": "#437FFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bridge uses your location to show nearby matches."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Bridge uses your contacts to help you invite friends via SMS."
        }
      ],
      "@sentry/react-native/expo",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.71474997929-p87rld819donm3a4odg05unl9ufunnlh"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1836c5e9-009d-477d-8769-8aef37693e5f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1836c5e9-009d-477d-8769-8aef37693e5f"
    }
  }
}
