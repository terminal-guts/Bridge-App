# Bridge Frontend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration (Required for real backend)
# ============================================
# Get these from your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Backend API Configuration
# ============================================
# Railway backend URL (or localhost for development)
EXPO_PUBLIC_BACKEND_URL=https://bridge-frontend-production.up.railway.app

# ============================================
# Content Moderation (Optional)
# ============================================
# Azure Content Safety API for text moderation
EXPO_PUBLIC_AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
EXPO_PUBLIC_AZURE_CONTENT_SAFETY_KEY=your-api-key-here

# ============================================
# Development Mode
# ============================================
# Set to 'mock-url' and 'mock-key' to use mock Supabase client
# EXPO_PUBLIC_SUPABASE_URL=mock-url
# EXPO_PUBLIC_SUPABASE_ANON_KEY=mock-key
