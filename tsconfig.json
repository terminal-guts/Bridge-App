{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "archive/**/*",
    "Bridge-Version1/**/*",
    "src/components/_archived/**/*",
    "supabase/functions/**/*",
    "node_modules"
  ]
}
